android_app {
    name: "KeyHandler",

    srcs: ["src/**/*.kt", "src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
    ],

    optimize: {
        enabled: true,
    },
}